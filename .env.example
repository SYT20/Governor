# Copy this file to `.env` and fill in whichever providers you plan to use.
#
#     cp .env.example .env
#
# `.env` is gitignored and is never read from source. Check what the harness
# can see at any time with:
#
#     make keys
#
# NO KEY IS NEEDED for `make test`, `make verify` or `make smoke` — the whole
# test suite and the end-to-end smoke run offline against a deterministic
# engine. Keys are only needed to collect NEW data from a live model.

# OpenRouter — https://openrouter.ai/keys
# Used for the Nemotron reasoning backend. Keys start with `sk-or-`.
OPENROUTER_API_KEY=

# Groq — https://console.groq.com/keys
# Higher daily limits than OpenRouter's free tier. Keys start with `gsk_`.
GROQ_API_KEY=

# Google AI Studio — https://aistudio.google.com/apikey
# Used for the Gemini backend. Keys start with `AIza`.
GEMINI_API_KEY=
